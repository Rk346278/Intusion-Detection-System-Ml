# ======================================================
# ML-Based Network Intrusion Detection System
# Flow-Level Behavioral Modeling + Isolation Forest
# Supports: Live Capture OR PCAP File
# ======================================================

from scapy.all import sniff, rdpcap, IP, TCP, UDP
from scapy.layers.inet6 import IPv6
import pandas as pd
import numpy as np
from sklearn.ensemble import IsolationForest
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

# ---------------- CONFIG ----------------
MODE = "pcap"   # "live" or "pcap"

PCAP_FILE = "real_network.pcapng"
INTERFACE = "en0"
CAPTURE_DURATION = 30
# ----------------------------------------

packets = []

# -------- 1. Capture Packets --------
if MODE == "live":
    print(f"Starting live capture on {INTERFACE} for {CAPTURE_DURATION} seconds...")
    packets = sniff(iface=INTERFACE, timeout=CAPTURE_DURATION)
else:
    print(f"Reading PCAP file: {PCAP_FILE}")
    packets = rdpcap(PCAP_FILE)

print("Total packets:", len(packets))


# -------- 2. Flow Creation (Five-Tuple) --------
flows = {}

for pkt in packets:
    if pkt.haslayer(IP) or pkt.haslayer(IPv6):

        if pkt.haslayer(IP):
            src_ip = pkt[IP].src
            dst_ip = pkt[IP].dst
            protocol = pkt[IP].proto
        else:
            src_ip = pkt[IPv6].src
            dst_ip = pkt[IPv6].dst
            protocol = pkt[IPv6].nh

        src_port = 0
        dst_port = 0

        if pkt.haslayer(TCP):
            src_port = pkt[TCP].sport
            dst_port = pkt[TCP].dport
        elif pkt.haslayer(UDP):
            src_port = pkt[UDP].sport
            dst_port = pkt[UDP].dport

        key = (src_ip, dst_ip, src_port, dst_port, protocol)

        pkt_size = len(pkt)
        pkt_time = float(pkt.time)

        if key not in flows:
            flows[key] = {
                "src_ip": src_ip,
                "dst_ip": dst_ip,
                "dst_port": dst_port,
                "packet_count": 0,
                "total_bytes": 0,
                "start_time": pkt_time,
                "end_time": pkt_time
            }

        flows[key]["packet_count"] += 1
        flows[key]["total_bytes"] += pkt_size
        flows[key]["end_time"] = pkt_time

print("Total flows:", len(flows))


# -------- 3. Feature Extraction --------
flow_data = []

for value in flows.values():
    duration = value["end_time"] - value["start_time"]
    if duration <= 0:
        duration = 0.0001

    avg_packet_size = value["total_bytes"] / value["packet_count"]
    packets_per_sec = value["packet_count"] / duration

    flow_data.append([
        value["src_ip"],
        value["dst_ip"],
        value["dst_port"],
        value["packet_count"],
        value["total_bytes"],
        avg_packet_size,
        duration,
        packets_per_sec
    ])

columns = [
    "src_ip",
    "dst_ip",
    "dst_port",
    "packet_count",
    "total_bytes",
    "avg_packet_size",
    "duration",
    "packets_per_second"
]

df = pd.DataFrame(flow_data, columns=columns)

if df.empty:
    print("No valid flows found.")
    exit()


# -------- 4. Prepare ML Data --------
X = df[[
    "packet_count",
    "total_bytes",
    "avg_packet_size",
    "duration",
    "packets_per_second",
    "dst_port"
]]

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)


# -------- 5. Isolation Forest --------
model = IsolationForest(contamination=0.05, random_state=42)
model.fit(X_scaled)

df["prediction"] = model.predict(X_scaled)
df["anomaly"] = df["prediction"].apply(lambda x: 1 if x == -1 else 0)


# -------- 6. Reporting --------
total_flows = len(df)
anomalies = df["anomaly"].sum()

print("\n========== ANALYSIS REPORT ==========")
print("Total Flows:", total_flows)
print("Anomalous Flows:", anomalies)
print("Normal Flows:", total_flows - anomalies)

print("\nTop Suspicious Source IPs:")
print(df[df["anomaly"] == 1]["src_ip"].value_counts().head())

print("\nTop Suspicious Destination Ports:")
print(df[df["anomaly"] == 1]["dst_port"].value_counts().head())


# -------- 7. Visualization --------
plt.figure()
plt.hist(df["anomaly"])
plt.title("Anomaly Distribution (0=Normal, 1=Anomaly)")
plt.xlabel("Anomaly")
plt.ylabel("Count")
plt.show()
